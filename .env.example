# Публичный HTTPS-адрес приложения (на локальной разработке — туннель ngrok / cloudflared)
NEXT_PUBLIC_APP_URL=https://your-diary-domain.vercel.app

# Supabase (из раздела Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Telegram Bot (от @BotFather)
TELEGRAM_BOT_TOKEN=1234567890:AAF...
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourSmartDiaryBot

# Секретная строка для верификации заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=super-secret-random-webhook-token-2026
